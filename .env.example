# Copy to .env (git-ignored) and fill in the token.
#
# The token is ORG-SCOPED. This repo's .chainloop.yml pins the organization, and the
# token must belong to that same org or the attestation push is rejected.
#
#   Organization: sbx-demo        (chainloop organization list)
#   Create with:  chainloop organization api-token create --name wad-demo
#
# Read by:  sbx run --clone --kit-args-file .env chainloop/sbx-kit-claude
chainloopToken=
